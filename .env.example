# ---------------------------------------------------------------- Site
# Used for canonical URLs, JSON-LD, the sitemap and the Merchant feed.
# Must be the exact production origin, with no trailing slash.
NEXT_PUBLIC_SITE_URL=https://home24care.com

# -------------------------------------------------------------- Stripe
# Dashboard > Developers > API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=sk_test_replace_me

# Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# Locally, `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints a whsec_... to use here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ------------------------------------------------------- Trustpilot reviews
# Trustpilot Business -> Integrations -> TrustBox. The generated snippet
# contains data-businessunit-id="...". Leave blank and every review widget
# renders nothing (no empty boxes, no placeholder ratings).
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
NEXT_PUBLIC_TRUSTPILOT_LOCALE=en-US

# Copy your current score and review count from the Trustpilot dashboard.
# These ONLY drive AggregateRating structured data, and are ignored unless the
# business unit id above is also set. Keep them current — stale rating markup
# that disagrees with the visible widget is a manual-action risk.
NEXT_PUBLIC_TRUSTPILOT_RATING=
NEXT_PUBLIC_TRUSTPILOT_REVIEW_COUNT=

# ------------------------------------------------------------ Admin & analytics
# Password for the /admin analytics dashboard. With this unset the dashboard is
# closed to everyone — an unconfigured deploy has no admin panel rather than an
# open one. Use something long and random.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie; falls back to ADMIN_PASSWORD.
# Set it to a separate random string so rotating the password does not have to
# invalidate every session, and vice versa.
ADMIN_SESSION_SECRET=

# Analytics storage. Without these the dashboard runs on in-memory storage,
# which is fine locally but useless on serverless — each invocation is a fresh
# process, so nothing accumulates. Create a free database at upstash.com, or
# use Vercel's Upstash integration which sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
